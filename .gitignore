# Datos crudos de scraping (AVL y BOE): demasiado grandes para GitHub y
# regenerables con los scripts documentados en cada README. boe_eval.jsonl
# se deriva del BOE, así que corre la misma suerte.
dades/avl/
dades/boe/
dades/dataset_entrenament/boe_eval.jsonl
# Muestras de trabajo intermedias (comparaciones de modelos en bruto, con logs)
dades/sintetic/muestra_comparativa_20260922_1254/

# 07_entrenament_de_models/: pesos de modelos y logs de ejecucion, nunca a git
# (los .gitkeep mantienen la carpeta en el repo aunque este vacia)
07_entrenament_de_models/checkpoints/*
!07_entrenament_de_models/checkpoints/.gitkeep
07_entrenament_de_models/runs/*
!07_entrenament_de_models/runs/.gitkeep

# 08_traduccio_corpus/: salida generada por traduccio_massiva.py, regenerable
08_traduccio_corpus/eixides/*
!08_traduccio_corpus/eixides/.gitkeep
dades/boe_net/corpus_entrenamiento_net.jsonl
