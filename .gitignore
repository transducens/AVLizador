__pycache__/
*.pyc
.venv/
venv/
.vscode/

# Memoria de trabajo para Claude Code entre sesiones (decisiones, qué se
# probó y descartó, estado del benchmark) -- NO es documentación del
# proyecto, esa vive en README.md/README.es.md y en los README.md de
# cada carpeta. Se queda solo en local.
CLAUDE.md
CLAUDE_HISTORIAL.md

# Datos crudos de scraping (AVL y BOE): demasiado grandes para GitHub y
# regenerables con los scripts documentados en cada README. boe_eval.jsonl
# se deriva del BOE, así que corre la misma suerte.
dades/avl/
dades/boe/
dades/dataset_entrenament/boe_eval.jsonl
# Muestras de trabajo intermedias (comparaciones de modelos en bruto, con logs)
dades/sintetic/muestra_comparativa_20260922_1254/

# pipeline/07_entrenament_de_models/: pesos de modelos y logs de ejecucion,
# nunca a git (los .gitkeep mantienen la carpeta en el repo aunque este
# vacia). Rutas actualizadas el 14/10/2026 (las carpetas numeradas se
# movieron dentro de pipeline/ -- un patron con "/" en medio queda anclado
# a donde vive el .gitignore, asi que sin el prefijo "pipeline/" dejaba de
# colar en silencio).
pipeline/07_entrenament_de_models/checkpoints/*
!pipeline/07_entrenament_de_models/checkpoints/.gitkeep
pipeline/07_entrenament_de_models/runs/*
!pipeline/07_entrenament_de_models/runs/.gitkeep

# pipeline/08_traduccio_corpus/: salida generada por traduccio_massiva.py,
# regenerable
pipeline/08_traduccio_corpus/eixides/*
!pipeline/08_traduccio_corpus/eixides/.gitkeep
dades/boe_net/corpus_entrenamiento_net.jsonl

# pipeline/03_seleccio_de_model/resultats/: salida de evalua_models.py,
# se acumula un fichero por cada run -- regenerable relanzando el benchmark
pipeline/03_seleccio_de_model/resultats/*
!pipeline/03_seleccio_de_model/resultats/.gitkeep
